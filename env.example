# ============================================
# QBit 환경 변수 예시
# 실제 값은 .env 파일에 채우세요 (커밋 금지)
# ============================================

# --- Supabase (dev profile) ---
SUPABASE_DB_JDBC_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.{project-ref}
SUPABASE_DB_PASSWORD=

# --- Gmail SMTP (dev profile) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# --- JWT (로컬 더미값 OK, 운영용 아님) ---
JWT_SECRET=local-dev-only-secret-do-not-use-in-prod-min-256-bits
JWT_ACCESS_EXP=3600
JWT_REFRESH_EXP=604800

# --- 매일메일 원본 환경변수 ---
ADMIN_SECRET=local-admin-secret
DISTRIBUTE_SERVER_COUNT=1
DISTRIBUTE_SERVER_INDEX=0

# --- Datadog (로컬에선 비활성화 더미) ---
DATADOG_KEY=disabled
DATADOG_FREQUENCY=disabled
DATADOG_URI=disabled
DATADOG_TAG=disabled
